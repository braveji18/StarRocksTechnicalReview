# 대규모 SF1000 — 대용량 조인/스필, 고동시성
# 연산 노드 8 x 32 vCPU / 256 GB / NVMe 4 TB 기준
#   lineitem 60억행 / 레이크 ~820 GB / StarRocks 네이티브(복제3) ~2.4 TB
# 파티션: month(84개). lineitem 태블릿 = 84 x 4 = 336개 x 약 600 MB
# 이 규모부터는 Trino tpch 커넥터 CTAS 가 느리다. dbgen + Spark 적재를 검토할 것.
SCALE_FACTOR=1000
TPCH_SCHEMA=sf1000
PARTITION_GRAIN=month
SR_BUCKETS_FACT=4
SR_BUCKETS_DIM=32
SR_REPLICAS=3
P1_REPEAT=3
P1_TIMEOUT_SEC=7200
P3_USERS=1,10,20,50,100,200
P3_DURATION_SEC=900
P3_WARMUP_SEC=180
SLA_DASHBOARD_P95_MS=3000
SLA_TARGET_CONCURRENT_USERS=100
