# 소규모 SF100 — 채점 최소 요건
# 연산 노드 3 x 16 vCPU / 64 GB / NVMe 1 TB 기준
#   lineitem 6억행 / 레이크 ~82 GB / StarRocks 네이티브(복제3) ~240 GB
# 파티션: year(7개). lineitem 태블릿 = 7 x 8 = 56개 x 약 360 MB
SCALE_FACTOR=100
TPCH_SCHEMA=sf100
PARTITION_GRAIN=year
SR_BUCKETS_FACT=8
SR_BUCKETS_DIM=8
SR_REPLICAS=3
P1_REPEAT=3
P1_TIMEOUT_SEC=1800
P3_USERS=1,5,10,20,50
P3_DURATION_SEC=600
P3_WARMUP_SEC=120
SLA_DASHBOARD_P95_MS=3000
SLA_TARGET_CONCURRENT_USERS=50
