# ---------------------------------------------------------------------------
# StarRocks vs Trino 기술 검토 - 공통 환경 변수
# 사용법: cp env/.env.example env/.env  후 값 수정
# ---------------------------------------------------------------------------

# 버전 고정 (docs/02 §3 - 착수 시 고정 후 검토 종료까지 변경 금지)
TRINO_VERSION=481
STARROCKS_VERSION=3.3-latest
ICEBERG_REST_VERSION=1.6.1
MINIO_VERSION=RELEASE.2024-09-13T20-26-02Z

# 접속 정보 (실 클러스터 측정 시 호스트만 바꾸면 스크립트 전체가 그대로 동작)
# 이미 구축된 클러스터에 붙일 때는 01-env-up.sh 를 쓰지 않고 아래 값만 맞춘다.
#   예) 기존 랩: TRINO_PORT=18080, LAKE_SCHEMA=bench, SR_EXTERNAL_CATALOG=iceberg
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=bench
TRINO_CATALOG=iceberg
TRINO_SCHEMA=tpch_sf1

SR_HOST=127.0.0.1
SR_PORT=9030
SR_USER=root
SR_PASSWORD=
SR_HTTP_PORT=8030

# 카탈로그/스키마
SR_EXTERNAL_CATALOG=iceberg_cat
SR_NATIVE_DB=tpch_sf1
LAKE_SCHEMA=tpch_sf1

# 데이터셋 규모. 로컬 스모크=1, 실측정=100 (docs/03 §1)
SCALE_FACTOR=1

# Iceberg 파티션 입도 (month|year|none).
# SF1 에 month 를 쓰면 84개 파티션이 생겨 파티션 라이터 메모리가 폭증한다.
# 소규모/저메모리 환경은 year 또는 none 을 쓴다.
PARTITION_GRAIN=month

# 오브젝트 스토리지
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=lake
ICEBERG_REST_URI=http://iceberg-rest:8181
# Hive Metastore 를 카탈로그로 쓰는 경우 (sql/ddl/20b-... 사용)
HMS_URI=thrift://hive-metastore:9083

# 모니터링
PROMETHEUS_URL=http://localhost:9090

# 측정 파라미터 (docs/05)
P1_REPEAT=3
P1_TIMEOUT_SEC=600
P3_USERS=1,5,10,20,50
P3_DURATION_SEC=600
P3_WARMUP_SEC=120

# SLA 임계값 (docs/01 §4 결격 조건 K2 - 착수 시 확정)
SLA_DASHBOARD_P95_MS=3000
SLA_TARGET_CONCURRENT_USERS=50

# 컨테이너 자원 (로컬 스모크 스택 기준. 두 엔진 총량을 동일하게 유지할 것)
TRINO_HEAP=3G
SR_FE_HEAP=2G
SR_BE_MEM_LIMIT=3G
